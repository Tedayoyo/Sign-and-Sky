# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543) or "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.YOURREF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# A long random string: openssl rand -base64 48
SESSION_SECRET=
# Optional. Leave empty until a CHIRPS extractor is running (see README).
CHIRPS_ENDPOINT=
# Optional. Set to "false" only for a local database without SSL.
DATABASE_SSL=
# Spoken Amharic replies (recommended): Addis AI → https://addisassistant.com/apikeys
ADDIS_API_KEY=
# Optional Amharic voice (default am-hamen)
ADDIS_TTS_VOICE_AM=
# Optional neural voice for English (and Amharic if no Addis key). Azure AI Speech: Speech resource → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Or Google Cloud Text-to-Speech API key
GOOGLE_TTS_API_KEY=
# Optional voice names, e.g. am-ET-AmehaNeural
TTS_VOICE_AM=
TTS_VOICE_EN=
# Optional: official address, e.g. https://signandsky.org
NEXT_PUBLIC_SITE_URL=
